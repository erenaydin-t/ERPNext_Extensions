   "fieldtype": "Data",
   "label": "Sayad Code",
   "allow_on_submit": 1,
   "read_only_depends_on": "eval:(doc.cheque_direction === \"Receivable\" && doc.workflow_state && doc.workflow_state !== \"Draft\") || (doc.cheque_direction === \"Payable\" && [\"Issued\", \"Cleared\", \"Returned\", \"Replaced\", \"Cancelled\", \"Bounced\", \"Endorsed\", \"Under Legal Action\"].includes(doc.workflow_state))"
  },
  {
   "fieldname": "sayad_registered",
   "fieldtype": "Check",
   "label": "Sayad Registered",
   "default": 0,
   "allow_on_submit": 1,
   "read_only_depends_on": "eval:(doc.cheque_direction === \"Receivable\" && doc.workflow_state && doc.workflow_state !== \"Draft\") || (doc.cheque_direction === \"Payable\" && [\"Issued\", \"Cleared\", \"Returned\", \"Replaced\", \"Cancelled\", \"Bounced\", \"Endorsed\", \"Under Legal Action\"].includes(doc.workflow_state))"
  },
