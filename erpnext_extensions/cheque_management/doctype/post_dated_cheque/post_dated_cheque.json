   "fieldtype": "Check",
   "label": "Sayad Registered",
   "default": 0
  },
  {
   "fieldname": "drawer_bank_name",
   "fieldtype": "Link",
   "label": "Drawer Bank Name",
   "options": "Bank",
   "mandatory_depends_on": "eval:doc.cheque_direction === \"Receivable\"",
   "description": "Bank that issued the cheque (required for Receivable)."
  },
  {
   "fieldname": "section_break_reference",
   "fieldtype": "Section Break",
   "label": "Reference",
   "collapsible": 1
