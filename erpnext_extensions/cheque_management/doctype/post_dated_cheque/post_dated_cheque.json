   "fieldtype": "Link",
   "label": "Workflow State",
   "options": "Workflow State",
   "default": "Draft",
   "read_only": 1,
   "allow_on_submit": 1,
   "description": "Process stage for this PDC. Values are Workflow State records; transitions use the active ERPNext Workflow \"PDC Workflow\" on this DocType. Python validation in validate() is the final authority."
  },
  {
   "fieldname": "cheque_status",
   "fieldtype": "Select",
   "label": "Cheque Status",
   "in_list_view": 1,
   "options": "Draft\nIn Hand\nIn Clearing\nCleared\nBounced\nEndorsed\nReturned to Customer\nReplaced\nUnder Legal Action\nCancelled\nIssued\nReturned from Payee",
   "default": "Draft",
   "read_only": 1,
   "allow_on_submit": 1,
   "description": "Operational reality of the cheque. Single Select with all Receivable and Payable labels; per-direction validity is enforced later in server/workflow logic. Updated by the system from workflow or accounting actions."
  },
  {
   "fieldname": "section_break_dates",
