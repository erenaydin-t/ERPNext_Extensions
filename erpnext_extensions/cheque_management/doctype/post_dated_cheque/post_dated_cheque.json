   "fieldtype": "Link",
   "label": "Account Paid To",
   "options": "Account",
   "description": "Payable: party payable account (supplier). For receivable cheques, defaults to Cheques in Hand from PDC Settings. Otherwise defaults from party or company accounts. Editable by user."
  },
