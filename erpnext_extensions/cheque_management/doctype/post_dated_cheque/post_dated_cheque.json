   "fieldtype": "Link",
   "label": "Cheques in Clearing Account",
   "options": "Account",
   "allow_on_submit": 1,
   "description": "Receivable only: intermediary clearing account used when moving to Sent to Bank. Defaults from PDC Settings if empty. Editable by user."
  },
