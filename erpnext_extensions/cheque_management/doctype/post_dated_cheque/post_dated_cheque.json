   "allow_on_submit": 1,
   "description": "Bank settlement (cheque cleared).",
   "mandatory_depends_on": "eval:doc.workflow_state===\"Cleared\""
  },
  {
   "fieldname": "column_break_dates_row1_col3",
   "fieldtype": "Column Break",
   "label": "Business return"
  },
  {
   "fieldname": "returned_date",
   "fieldtype": "Date",
   "label": "Returned Date",
   "description": "Business return to party (not bank bounce).",
   "mandatory_depends_on": "eval:doc.workflow_state===\"Returned\"",
   "allow_on_submit": 1
  },
  {
   "fieldname": "handover_date",
   "fieldtype": "Date",
   "label": "Handover / Endorsement Date",
   "description": "Payable: physical handover to payee. Receivable: endorsement / transfer to another party.",
   "mandatory_depends_on": "eval:(doc.cheque_direction===\"Payable\" && doc.workflow_state===\"Issued\") || doc.workflow_state===\"Endorsed\"",
   "allow_on_submit": 1
  },
  {
   "fieldname": "column_break_dates_row2_col2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "bounced_date",
   "fieldtype": "Date",
   "label": "Bounced Date",
   "description": "Bank rejection / dishonour.",
   "mandatory_depends_on": "eval:doc.workflow_state===\"Bounced\"",
   "allow_on_submit": 1
  },
  {
   "fieldname": "column_break_dates_row2_col3",
   "fieldtype": "Column Break"
