   "fieldname": "bank_account",
   "fieldtype": "Link",
   "label": "Bank Account",
   "options": "Bank Account",
   "mandatory_depends_on": "eval:doc.cheque_direction === \"Payable\"",
   "allow_on_submit": 1,
   "description": "Required for Payable cheques; for Receivable required when In Clearing/Cleared. Editable after submit when workflow moves to Sent to Bank / Cleared (or Issued/Cleared Payable)."
  },
  {
   "fieldname": "column_break_cheque",
